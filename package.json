{
  "name": "momomoniqi",
  "private": true,
  "version": "0.3.0",
  "description": "嬷嬷模拟器 momomoniqi —— 把严肃角色宠成全网嬷嬷的创意工作台",
  "author": "momomoniqi",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:electron": "npm run build && electron .",
    "build:preview:win": "npm run build && electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.momomoniqi.preview",
    "productName": "momomoniqi-preview",
    "directories": {
      "output": "dist-preview"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "momomoniqi-preview-${version}-win-portable.exe"
    }
  }
}
